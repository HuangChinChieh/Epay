<body class="theme-cyan">
    <div class="block-header paper-wrap">
        <div class="row">
            <div class="col col-lg-3 col-md-3 col-sm-3">
                <h2>渠道間轉帳</h2>
            </div>
            <div class="col col-lg-9 col-md-9 col-sm-9">
                <div class="tips">
                    <span>將商戶某個支付渠道的餘額，轉一部分到同商戶、同幣別的另一個渠道，不影響商戶總額。</span>
                </div>
            </div>

        </div>
    </div>

    <div class="container-fluid">
        <!-- Vertical Layout -->
        <div class="row clearfix">
            <div class="col-lg-12 col-md-12 col-sm-12">
                <div class="card">
                    <div class="header"></div>
                    <div class="body">
                        <form>

                            <label>商户 :</label>
                            <select class="form-control show-tick" id="select_company"></select>
                            <label>币别 :</label>
                            <select class="form-control show-tick" id="select_currency"><option>请先选择一间商户</option></select>

                            <label>轉出渠道 :</label>
                            <select class="form-control show-tick" id="select_FromServiceType">
                                <option value="-99">请先选择币别</option>
                            </select>
                            <div id="divBalanceInfo" style="display:none">
                                轉出渠道目前可用金額 : <span class="balance-value" id="spanFromCanUsePoint">0</span>
                            </div>

                            <label>轉入渠道 :</label>
                            <select class="form-control show-tick" id="select_ToServiceType">
                                <option value="-99">请先选择币别</option>
                            </select>

                            <label for="Amount">轉帳金额 : </label>
                            <div class="tips" style="padding-left:0;margin-bottom:4px;">請輸入正數，系統會自動從轉出渠道扣款、轉入渠道加點，不用自己填負數</div>
                            <div class="form-group">
                                <input type="number" id="Amount" class="form-control thousand-symbols" min="0.01" step="0.01" placeholder="請輸入正數金額">
                            </div>
                            <label for="Description">备注 : </label>
                            <div class="form-group">
                                <input type="text" id="Description" class="form-control thousand-symbols">
                            </div>
                            <div class="text-center">
                                <button type="button" class="btn btn-raised btn-primary btn-round waves-effect" id="btn_Save">储存</button>
                                <button type="button" class="btn btn-raised btn-primary btn-round waves-effect" id="btn_Cancel">取消</button>
                            </div>

                        </form>
                    </div>
                    <div class="footer"></div>
                </div>
            </div>
        </div>
        <!-- #END# Vertical Layout -->
    </div>
</body>
    <script>

        var EditData = parent.CheckTempDataType("CompanyServicePointTransfer");
        var seleCurrency = parent.API_GetSelectCurrency();
        var selectedCompanyID = -99;

        $(document).ready(function () {
            pageLoad();
        });

        function pageLoad() {

            if ('@CheckLoginPermission' == 'false') {
                location.href = "Login.cshtml";
            }

            AdminObject = parent.AdminObject;
            api = parent.api;
            //建立下拉
            CreateCompanySelect();

            parent.wrapperFadeOut();
        }


        //儲存
        $("#btn_Save").on("click", function () {
            var Amount = $("#Amount").val().trim();
            var Description = $("#Description").val().trim();
            var company = $('#select_company').val();
            var currency = $("#select_currency").val();
            var FromServiceType = $('#select_FromServiceType').val();
            var ToServiceType = $('#select_ToServiceType').val();

            //#region 驗證
            if (company == -99) {
                parent.warningAlert("请选择商户");
                return;
            }

            if (FromServiceType == -99 || ToServiceType == -99) {
                parent.warningAlert("请选择轉出與轉入渠道");
                return;
            }

            if (FromServiceType == ToServiceType) {
                parent.warningAlert("轉出與轉入渠道不可相同");
                return;
            }

            if (Amount == "" || toNumber(Amount) <= 0) {
                parent.warningAlert("请先输入金额");
                return;
            }

            if (Description == "") {
                parent.warningAlert("请先输入备注");
                return;
            }
            //#endregion

            api.transferCompanyServicePoint(company, currency, FromServiceType, ToServiceType, Amount, Description, function (success, obj) {
                if (success) {
                    if (obj.ResultCode == 0) {
                        parent.successAlert(function () {
                            parent.refreshPage(EditData.data.backID);
                            parent.CloseActivePage(window.frameElement.name);
                        });
                    } else {
                        var message = "";
                        switch (obj.ResultCode) {
                            case 4:
                                parent.errorAlertCallback("权限不足", function () {
                                    parent.ChangePage("Home");
                                    parent.CloseActivePage(window.frameElement.id.split('_')[1]);
                                });
                                break;
                            case 7:
                                parent.errorAlert("您已断线请重新登入", "Login.cshtml");
                                break;
                            default:
                                message = obj.Message;
                                break;
                        }

                        parent.warningAlert(message);
                    }
                }
            });
        })
        //取消回檢視頁面
        $("#btn_Cancel").on("click", function () {
            parent.ChangePage(EditData.data.backID);
            parent.CloseActivePage(window.frameElement.name);

        })

        function CreateCompanySelect() {
            $('#select_company').html("");
            api.getCompanyTableResult(function (s, o) {
                if (s) {
                    if (o.ResultCode == 0) {
                        $("#select_company").append('<option value="-99">选择商户</option>');
                        $.each(o.CompanyResults, function (i, item) {
                            $("#select_company").append('<option value="' + o.CompanyResults[i].CompanyID + '">' + o.CompanyResults[i].CompanyName + '</option>');
                        })

                        $('#select_company').change(function () {
                            parent.wrapperFadeIn();
                            selectedCompanyID = $(this).val();
                            resetChannelSelects();
                            createCurrencySelect($(this).val());
                        });
                        $('#select_company').selectpicker('refresh');

                    } else {
                        switch (o.ResultCode) {
                            case 4:
                                parent.errorAlertCallback("权限不足", function () {
                                    parent.ChangePage("Home");
                                    parent.CloseActivePage(window.frameElement.id.split('_')[1]);
                                });
                                break;
                            case 5:
                                break;
                            case 7:
                                parent.errorAlert("您已断线请重新登入", "Login.cshtml");
                                break;
                            default:
                                parent.warningAlert("其他错误");
                                break;
                        }
                    }
                    //消除遮罩
                    parent.wrapperFadeOut();
                }
            });

        }

        function createCurrencySelect(selCompanyid) {

            $('#select_currency').html("");
            resetChannelSelects();
            api.getCompanyPointTableResult(selCompanyid, seleCurrency, function (s, o) {
                if (s) {
                    if (o.ResultCode == 0) {
                        $.each(o.CompanyPoints, function (i, item) {
                            $("#select_currency").append('<option value="' + o.CompanyPoints[i].CurrencyType + '">' + o.CompanyPoints[i].CurrencyType + '</option>');
                        })
                        $('#select_currency').selectpicker('refresh');

                        $('#select_currency').off('change').change(function () {
                            CreateServiceTypeSelects(selCompanyid, $(this).val());
                        });

                        if (o.CompanyPoints.length > 0) {
                            CreateServiceTypeSelects(selCompanyid, o.CompanyPoints[0].CurrencyType);
                        }

                    } else {
                        switch (o.ResultCode) {
                            case 4:
                                parent.errorAlertCallback("权限不足", function () {
                                    parent.ChangePage("Home");
                                    parent.CloseActivePage(window.frameElement.id.split('_')[1]);
                                });
                                break;
                            case 5:
                                break;
                            case 7:
                                parent.errorAlert("您已断线请重新登入", "Login.cshtml");
                                break;
                            default:
                                $("#select_currency").append('<option value="-99">该商户未设定币别</option>');
                                $('#select_currency').selectpicker('refresh');
                                break;
                        }
                    }
                    //消除遮罩
                    parent.wrapperFadeOut();
                }
            });
        }

        function resetChannelSelects() {
            $('#select_FromServiceType').html('<option value="-99">请先选择币别</option>');
            $('#select_FromServiceType').selectpicker('refresh');
            $('#select_ToServiceType').html('<option value="-99">请先选择币别</option>');
            $('#select_ToServiceType').selectpicker('refresh');
            $('#divBalanceInfo').hide();
        }

        function CreateServiceTypeSelects(companyid, currency) {
            api.getCompanyServiceTableResult(companyid, function (s, o) {
                if (s) {
                    if (o.ResultCode == 0) {
                        var filtered = $.grep(o.CompanyServiceResults, function (item) {
                            return item.CurrencyType == currency;
                        });

                        $('#select_FromServiceType').html('<option value="-99">请选择转出渠道</option>');
                        $('#select_ToServiceType').html('<option value="-99">请选择转入渠道</option>');

                        $.each(filtered, function (i, item) {
                            $("#select_FromServiceType").append('<option value="' + item.ServiceType + '">' + item.ServiceTypeName + '</option>');
                            $("#select_ToServiceType").append('<option value="' + item.ServiceType + '">' + item.ServiceTypeName + '</option>');
                        })

                        $('#select_FromServiceType').selectpicker('refresh');
                        $('#select_ToServiceType').selectpicker('refresh');

                        $('#select_FromServiceType').off('change').change(function () {
                            RefreshFromServicePointBalance(companyid, currency, $(this).val());
                        });

                    } else {
                        $('#select_FromServiceType').html('<option value="-99">该商户未设定支付类型</option>');
                        $('#select_FromServiceType').selectpicker('refresh');
                        $('#select_ToServiceType').html('<option value="-99">该商户未设定支付类型</option>');
                        $('#select_ToServiceType').selectpicker('refresh');
                    }
                    //消除遮罩
                    parent.wrapperFadeOut();
                }
            });
        }

        function RefreshFromServicePointBalance(companyid, currency, serviceType) {
            if (serviceType == -99 || !serviceType) {
                $('#divBalanceInfo').hide();
                return;
            }

            parent.wrapperFadeIn();
            api.getCompanyServicePointBalanceByAdmin(companyid, serviceType, currency, function (success, obj) {
                parent.wrapperFadeOut();
                if (success && obj.ResultCode == 0 && obj.CompanyServicePoint) {
                    var canUsePoint = obj.CompanyServicePoint.CanUsePoint - obj.CompanyServicePoint.FrozenPoint;
                    $('#spanFromCanUsePoint').text(toCurrency(canUsePoint));
                    $('#spanFromCanUsePoint').removeClass('balance-warning').addClass('balance-value');
                    $('#divBalanceInfo').show();
                } else {
                    $('#spanFromCanUsePoint').text("0");
                    $('#spanFromCanUsePoint').removeClass('balance-value').addClass('balance-warning');
                    $('#divBalanceInfo').show();
                }
            });
        }
    </script>
